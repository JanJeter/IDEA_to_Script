# ===== AI 配置 =====
# 不填写任何 Key 时，工具自动进入 mock 模式：从你输入的小说真实抽取人物/地点/场景，
# 产出一份可被 Schema 校验通过的示例剧本，无需联网即可运行。
# 在根目录下创建一个.env 文件，内容如下：
# OpenAI（或任意兼容 OpenAI Chat Completions 协议的服务）API Key
OPENAI_API_KEY=

# 可选：自定义 API Base URL（接入 Azure OpenAI / 国内大模型兼容网关 / 自建代理）
# 例如：https://api.openai.com/v1
# 比如我要接入 Deepseek 模型，我需要配置为：
OPENAI_BASE_URL=https://api.deepseek.com

# 使用的模型名
OPENAI_MODEL=deepseek-v4-flash

# 强制 mock 模式（即使配置了 Key 也走本地 mock，便于演示/测试）。设为 1 开启。
#USE_MOCK=
