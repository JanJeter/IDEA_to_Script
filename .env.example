# PostgreSQL
DATABASE_URL="postgresql://screenwriter:screenwriter@localhost:5433/idea2screenplay?schema=public"

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# The development values below are public and production startup rejects them.
# COOKIE_SIGNING_KEY and VISITOR_IDENTITY_KEY are kept temporarily so a browser
# with a former ids_visitor cookie can claim its existing projects on register.
COOKIE_SIGNING_KEY=development-cookie-signing-key-change-me
COOKIE_SIGNING_KEY_PREVIOUS=
VISITOR_IDENTITY_KEY=development-cookie-signing-key-change-me
IP_HASH_KEY=development-ip-hash-key-change-me
ALTCHA_HMAC_KEY=development-altcha-signing-key-change-me
# Use a separate random value in production. This HMACs login throttle subjects.
AUTH_THROTTLE_KEY=development-auth-throttle-key-change-me
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_GLOBAL_MAX=200
AUTH_LOGIN_IP_MAX=20
AUTH_LOGIN_IDENTIFIER_MAX=10
AUTH_REGISTER_WINDOW_MINUTES=60
AUTH_REGISTER_GLOBAL_MAX=50
AUTH_REGISTER_IP_MAX=5
AUTH_REGISTER_USERNAME_MAX=5
AUTH_PASSWORD_CONCURRENCY=4
AUTH_PASSWORD_QUEUE_MAX=32
AUTH_PASSWORD_QUEUE_WAIT_MS=10000

# Optional migration bridge only. Keep the former production codes here during
# the account migration window so a signed legacy cookie maps to its old seat.
# New registration and login never accept or issue access codes.
APP_ACCESS_CODES=
VISITOR_RETENTION_DAYS=30

# Abuse protection and complete-workflow admission ceilings for a 100-seat rollout.
# They are not Token/currency ceilings; set a provider-side spend cap separately.
VISITOR_PROJECT_LIMIT=5
IP_PROJECTS_PER_DAY=200
VISITOR_GENERATIONS_PER_DAY=3
IP_GENERATIONS_PER_DAY=100
GLOBAL_GENERATIONS_PER_DAY=100
GLOBAL_GENERATIONS_PER_MONTH=3000
GENERATION_CONCURRENCY=2
SERIALIZABLE_TRANSACTION_CONCURRENCY=1
SERIALIZABLE_TRANSACTION_QUEUE_LIMIT=256
SERIALIZABLE_TRANSACTION_WAIT_TIMEOUT_MS=15000
JOB_RETRY_LIMIT=2
JOB_EXPIRE_SECONDS=900
PROJECT_REGENERATIONS_MAX=3
ALTCHA_COST=1000
ALTCHA_CHALLENGES_PER_10_MINUTES=20

# Local development only. Production refuses to start when this is true.
LOCAL_UNLIMITED_MODE=false

# LLM provider. Only normalized DEMO_MODE=false plus a non-empty key enables paid calls.
# Invalid DEMO_MODE values reject production startup; leave the key empty in demo mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=90000
LLM_MAX_OUTPUT_TOKENS=4096
# Optional provider-specific thinking toggle: enabled or disabled.
LLM_THINKING_MODE=
DEMO_MODE=true

# Controlled Agent runtime. Keep legacy until the provider tool-call smoke test passes.
GENERATION_RUNTIME=legacy
AGENT_ENABLED_STAGES=PREMISE
AGENT_PREMISE_MAX_STEPS=4
# Backward-compatible per-request context budget. The explicit key below wins.
AGENT_PREMISE_TOKEN_BUDGET=16000
AGENT_PREMISE_CONTEXT_TOKEN_BUDGET=16000
AGENT_PREMISE_CUMULATIVE_TOKEN_BUDGET=64000
AGENT_PROVIDER_ATTEMPTS_PER_STEP=2
AGENT_MAX_PROVIDER_CALLS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_MS=90000

# Public trend monitor. Wikimedia zh daily top pages is always enabled and needs no key.
# Fetch cadence is DB-backed so public refresh clicks cannot bypass it.
TRENDS_FETCH_TTL_MS=7200000
TRENDS_STALE_AFTER_MS=21600000
TRENDS_REFRESH_INTERVAL_MS=300000
TRENDS_REFRESH_COOLDOWN_MS=60000
TRENDS_RETENTION_DAYS=14
TRENDS_SOURCE_TIMEOUT_MS=8000
TRENDS_SOURCE_FAILURE_BACKOFF_MS=300000
TRENDS_MAX_RESPONSE_BYTES=1048576
TRENDS_USER_AGENT="AIScriptTrendBot/0.1 (contact: you@example.com)"
TRENDS_WIKIMEDIA_LIMIT=24
# Optional normalized HTTPS JSON feed. Private/local targets and redirects are rejected.
TRENDS_JSON_FEED_URL=
TRENDS_JSON_FEED_LIMIT=30
# Development-only escape hatch for a local test feed; ignored in production.
TRENDS_ALLOW_PRIVATE_JSON_FEED=false
# Optional paid Baidu Qianfan Baidu-hot-search tabs. Each tab is a paid API call per fetch.
# The retired trending_lists endpoint is not used. The two-hour minimum is deliberate:
# lowering it increases paid calls across every configured tab.
TRENDS_QIANFAN_API_KEY=
# Safe tabs: livelihood, finance, sports, new_entertainment, internation_news,
# challenge, movie, teleplay, novel. Default: livelihood,new_entertainment,finance.
TRENDS_QIANFAN_BAIDU_TABS=livelihood,new_entertainment,finance
TRENDS_QIANFAN_LIMIT_PER_TAB=15
# Optional official X API v2 regional trends. No web scraping or Post/user storage.
# Keep approval false until the declared X developer use case covers this workflow.
# Supported documented WOEIDs: Worldwide 1, US 23424977, UK 23424975,
# Japan 23424856, New York 2459115, Los Angeles 2442047, London 44418, Tokyo 1118370.
TRENDS_X_BEARER_TOKEN=
TRENDS_X_USE_CASE_APPROVED=false
TRENDS_X_WOEIDS=23424977,23424975
TRENDS_X_FETCH_TTL_MS=1800000
# Optional official Weibo commercial hot-word API. Keep disabled until your
# contract explicitly covers stored trend snapshots and AI-assisted fiction ideation.
# Prefer the contract/IP-authorized AppKey mode. OAuth is a fallback and requires rotation.
TRENDS_WEIBO_APP_KEY=
TRENDS_WEIBO_ACCESS_TOKEN=
TRENDS_WEIBO_COMMERCIAL_APPROVED=false
TRENDS_WEIBO_COUNT=50
TRENDS_WEIBO_FETCH_TTL_MS=300000
# Optional YouTube Data API v3 discovery feed. Since mostPopular now covers
# Music/Movies/Gaming rather than the full Trending page, do not call it a social hot list.
# Keep derivative-use approval false until your policy review permits cross-source scoring
# and abstract fiction ideation from this API data.
TRENDS_YOUTUBE_API_KEY=
TRENDS_YOUTUBE_DERIVATIVE_USE_APPROVED=false
TRENDS_YOUTUBE_REGIONS=US,GB
TRENDS_YOUTUBE_LIMIT_PER_REGION=20
TRENDS_YOUTUBE_FETCH_TTL_MS=3600000

# Frontend
VITE_API_URL=http://localhost:3000/api

# Production only: fixed public IPv4 used as the website address.
# Copy production values to .env.production on the server; do not commit secrets.
PUBLIC_IP=
POSTGRES_USER=screenwriter
POSTGRES_PASSWORD=
POSTGRES_DB=idea2screenplay
