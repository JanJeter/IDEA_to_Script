{
  "name": "@idea2screenplay/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build -w @idea2screenplay/agent",
    "build": "nest build",
    "predev": "npm run build -w @idea2screenplay/agent",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prelint": "npm run build -w @idea2screenplay/agent",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run build -w @idea2screenplay/agent",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "auth:reset-password": "node --env-file-if-exists=../../.env dist/security/reset-user-password.cli.js"
  },
  "dependencies": {
    "@idea2screenplay/agent": "0.1.0",
    "@ai-sdk/openai": "2.0.44",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "ai": "5.0.98",
    "altcha-lib": "^2.3.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg-boss": "^12.27.0",
    "prisma": "^6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
